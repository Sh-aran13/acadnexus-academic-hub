# AcadNexus Academic Management System - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acadnexus
DB_USER=postgres
DB_PASS=your_secure_password_here

# Application Configuration
APP_ENV=production
APP_URL=http://localhost/AcadNexus
APP_SECRET=generate_a_random_32_character_secret_here

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false

# File Upload Configuration
UPLOAD_MAX_SIZE=26214400
UPLOAD_DIR=uploads/
